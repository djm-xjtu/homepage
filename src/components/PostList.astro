---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  /** Show the date above each title (used on /blog/, hidden on the home page). */
  showDate?: boolean;
}

const { posts, showDate = false } = Astro.props;
const base = import.meta.env.BASE_URL;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<ul class="posts">
  {
    posts.map((post) => {
      const href = post.data.external ?? `${base}/blog/${post.id}/`.replace(/\/+/g, '/');
      const external = Boolean(post.data.external);
      return (
        <li>
          <a
            class="post-link"
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
          >
            {showDate && <span class="post-link__date">{fmt(post.data.date)}</span>}
            <span class="post-link__title">
              {post.data.title}
              {external && <span aria-hidden="true"> ↗</span>}
            </span>
            <span class="post-link__desc">{post.data.description}</span>
          </a>
        </li>
      );
    })
  }
</ul>
