---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const nav = [
  { label: 'blog', href: `${base}/blog/`.replace(/\/+/g, '/') },
  { label: 'work', href: `${base}/work/`.replace(/\/+/g, '/') },
  ...(site.cv ? [{ label: 'cv', href: `${base}/cv/`.replace(/\/+/g, '/') }] : []),
];

const home = `${base}/`.replace(/\/+/g, '/');
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href={home}>{site.name}</a>
    <nav class="nav" aria-label="Primary">
      {
        nav.map((item, i) => (
          <>
            {i > 0 && <span class="nav__sep">/</span>}
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </>
        ))
      }
      <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Toggle colour theme">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>
