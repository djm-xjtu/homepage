---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';

const all = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const groupByYear = (posts: CollectionEntry<'blog'>[]) => {
  const map = new Map<number, CollectionEntry<'blog'>[]>();
  for (const p of posts) {
    const y = p.data.date.getFullYear();
    if (!map.has(y)) map.set(y, []);
    map.get(y)!.push(p);
  }
  return [...map.entries()].sort((a, b) => b[0] - a[0]);
};

const english = groupByYear(all.filter((p) => p.data.lang !== 'zh'));
const chinese = groupByYear(all.filter((p) => p.data.lang === 'zh'));
---

<Base title="Blog" description="Writing by Jiaming Deng on storage systems, distributed systems and AI agents.">
  <h1>Blog</h1>

  {all.length === 0 && <p class="empty-note">No posts yet — the first one is being written.</p>}

  {
    english.map(([year, posts]) => (
      <>
        <h2 class="year-head">{year}</h2>
        <PostList posts={posts} showDate />
      </>
    ))
  }

  {
    chinese.length > 0 && (
      <>
        <h2>中文文章</h2>
        {chinese.map(([year, posts]) => (
          <>
            <h3 class="year-head">{year}</h3>
            <PostList posts={posts} showDate />
          </>
        ))}
      </>
    )
  }
</Base>
