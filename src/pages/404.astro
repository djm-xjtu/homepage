---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Not found" description="Page not found.">
  <h1>404</h1>
  <p class="lead">That page doesn&rsquo;t exist — it may have moved or never existed at all.</p>
  <p><a href={`${base}/`.replace(/\/+/g, '/')}>← Back home</a></p>
</Base>
